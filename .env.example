# Copy to .env and set a read-only UptimeRobot API key.
STATUS_HOST=127.0.0.1
STATUS_PORT=3020
STATUS_REQUEST_TIMEOUT_MS=5000
STATUS_RESULT_CACHE_MS=30000
STATUS_CLIENT_REFRESH_MS=60000
STATUS_DASHBOARD_API_PATH=/api/status

UPTIMEROBOT_API_URL=https://api.uptimerobot.com/v3/monitors
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_MONITOR_LIST_LIMIT=200
UPTIMEROBOT_MONITORS_JSON=[{"id":"production-web","label":"Geet Web","url":"https://listengeet.com"},{"id":"shared-api","label":"Geet API","url":"https://api.listengeet.com"},{"id":"development-web","label":"Geet Development","url":"https://dev.listengeet.com"}]
